<?xml version="1.0" encoding="UTF-8"?>
<!-- 猫子云 OAuth 认证授权服务聚合工程，聚合管理 OAuth API 接口和 OAuth 业务实现子模块 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承猫子云统一父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-services</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- OAuth 认证授权服务聚合工程构件名称 -->
	<artifactId>maozi-cloud-business-oauth</artifactId>
	<!-- 打包类型为 pom，表示这是一个聚合工程 -->
	<packaging>pom</packaging>

	<properties>

		<!-- Oauth Begin -->
		<!-- OAuth API 接口层版本号 -->
		<maozi-cloud-oauth-api.version>${revision}</maozi-cloud-oauth-api.version>
		<!-- Oauth End -->

		<!-- User Begin -->
		<!-- 系统 API 接口版本号，OAuth 服务依赖系统管理接口 -->
		<maozi-cloud-system-api.version>2.0.0</maozi-cloud-system-api.version>
		<!-- User End -->

	</properties>


	<!-- 子模块列表 -->
	<modules>
		<!-- OAuth API 接口层模块，定义认证授权服务的对外接口 -->
		<module>maozi-cloud-oauth-api</module>
		<!-- OAuth 业务实现模块，提供认证授权的具体业务逻辑 -->
		<module>maozi-cloud-oauth-service</module>
		<module>maozi-cloud-oauth-run</module>
	</modules>


</project>
