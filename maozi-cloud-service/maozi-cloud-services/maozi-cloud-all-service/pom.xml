<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承猫子云统一父工程，统一管理依赖版本 -->
    <parent>
        <groupId>com.maozi</groupId>
        <artifactId>maozi-cloud-services</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>maozi-cloud-all-service</artifactId>

    <properties>

        <!-- 跳过单元测试 -->
        <maven.test.skip>true</maven.test.skip>
        <!-- 跳过 install 阶段 -->
        <maven.install.skip>true</maven.install.skip>
        <!-- 跳过 deploy 阶段 -->
        <maven.deploy.skip>true</maven.deploy.skip>

    </properties>


    <dependencies>

        <!-- 数据库实现插件，提供 MyBatis-Plus、数据源等数据库访问能力 -->
        <dependency>
            <groupId>com.maozi</groupId>
            <artifactId>maozi-cloud-service-db-impl</artifactId>
            <version>${maozi-cloud-service-db-impl.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.maozi</groupId>
                    <artifactId>maozi-cloud-config-discovery</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.maozi</groupId>
                    <artifactId>maozi-cloud-config-oauth</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.maozi</groupId>
                    <artifactId>maozi-cloud-config-dubbo</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.maozi</groupId>
                    <artifactId>maozi-cloud-config-feign</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.maozi</groupId>
                    <artifactId>maozi-cloud-config-sentinel</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>


    <!-- boot打包 Begin -->
    <build>
        <!-- 打包后的文件名 -->
        <finalName>${artifactId}</finalName>
        <plugins>
            <!-- Spring Boot Maven 插件，将应用打包为可执行 JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 指定应用启动主类 -->
                    <mainClass>com.maozi.Application</mainClass>
                    <!-- 包含 system scope 的依赖 -->
                    <includeSystemScope>true</includeSystemScope>
                    <!-- 排除 Lombok，运行时不需要 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- 添加 add-opens jvm参数 -->
                    <jvmArguments>
                        --add-opens java.base/java.math=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!-- 重新打包为可执行 JAR -->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- boot打包 End -->


</project>