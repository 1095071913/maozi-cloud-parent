<?xml version="1.0" encoding="UTF-8"?>
<!-- 猫子云系统管理服务聚合工程，聚合管理系统 API 接口和系统业务实现子模块 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承猫子云统一父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-services</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- 系统管理服务聚合工程构件名称 -->
	<artifactId>maozi-cloud-business-system</artifactId>
	<!-- 打包类型为 pom，表示这是一个聚合工程 -->
	<packaging>pom</packaging>

	<properties>

		<!-- Oauth Begin -->
		<!-- 系统 API 接口层版本号 -->
		<maozi-cloud-system-api.version>${revision}</maozi-cloud-system-api.version>
		<!-- Oauth End -->

		<!-- User Begin -->
		<!-- OAuth API 接口版本号，系统服务依赖 OAuth 认证接口 -->
		<maozi-cloud-oauth-api.version>2.0.0</maozi-cloud-oauth-api.version>
		<!-- User End -->

	</properties>

	<!-- 子模块列表 -->
	<modules>
		<!-- 系统 API 接口层模块，定义系统管理服务的对外接口 -->
		<module>maozi-cloud-system-api</module>
		<!-- 系统业务实现模块，提供系统管理的具体业务逻辑 -->
        <module>maozi-cloud-system-service</module>
	</modules>

</project>
