# ============================================================
# Nacos Server 环境变量 —— 通过 docker-compose 的 env_file 注入
# ------------------------------------------------------------
# 内容分类：
#   - 部署形态：PREFER_HOST_MODE / MODE
#   - 持久化：SPRING_DATASOURCE_PLATFORM + MYSQL_SERVICE_* 系列
# ------------------------------------------------------------
# !! 配置约束 !!
#   1. MYSQL_SERVICE_DB_NAME 必须与 maozi-cloud-nacos-test-db.sql 导入的库名一致；
#   2. MYSQL_SERVICE_HOST=maozi-cloud-basic-mysql 依赖 docker-compose 中 mysql 服务名；
#   3. 示例密码为弱口令，部署环境请替换并配合 .env 加载。
# ============================================================

# 主机优先模式（hostname），容器以主机名注册到集群
PREFER_HOST_MODE=hostname
# 单机模式（standalone），无集群
MODE=standalone
# 持久化平台选择 mysql
SPRING_DATASOURCE_PLATFORM=mysql
# 数据库主机：与 docker-compose 中 mysql 服务名保持一致
MYSQL_SERVICE_HOST=maozi-cloud-basic-mysql
# Nacos 配置库库名：需先通过 maozi-cloud-nacos-middleware-db.sql 导入
MYSQL_SERVICE_DB_NAME=maozi-cloud-nacos-middleware-db
# 数据库端口
MYSQL_SERVICE_PORT=3306
# 数据库账号（示例环境为 root，生产请改为受限账号）
MYSQL_SERVICE_USER=root
# 数据库密码（示例弱口令，部署环境务必替换）
MYSQL_SERVICE_PASSWORD=password
# JDBC 连接附加参数：UTF-8 编码 + 超时 + Asia/Shanghai 时区
MYSQL_SERVICE_DB_PARAM=characterEncoding=utf8&connectTimeout=1000&socketTimeout=3000&autoReconnect=true&useSSL=false&serverTimezone=Asia/Shanghai