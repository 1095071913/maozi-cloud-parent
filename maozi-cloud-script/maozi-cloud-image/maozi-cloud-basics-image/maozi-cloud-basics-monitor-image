# ============================================================
# Dockerfile —— Monitor 基础服务镜像
# ------------------------------------------------------------
# 基础镜像：maozi-cloud-base-jdk:1.0.0
# 部署制品：maozi-cloud-basics-monitor.jar（由 maozi-cloud-build 流程产出）
# 暴露端口：APPLICATION_PORT=2000（Spring Boot Admin Web UI）
# 注意：监控为 Spring Boot Admin Server（Servlet），
#       无需 Dubbo 端口，因此 CMD 中没有 DUBBO_IP_TO_REGISTRY。
# ------------------------------------------------------------
# JVM 参数（针对小规格容器调优，详细解释见 *-service-image）：
#   -Xms256m -Xmx256m / -Xss256k / -XX:MaxMetaspaceSize=192m
#   -XX:+UseSerialGC / -XX:CompressedClassSpaceSize=32m
#   -XX:ReservedCodeCacheSize=32m / -XX:MaxDirectMemorySize=32m
#   --add-opens java.base/...=ALL-UNNAMED JDK 17 模块化开放，供反射框架使用
# ============================================================
FROM maozi-cloud-base-jdk:1.0.0

ENV APPLICATION_NAME=maozi-cloud-monitor
ENV APPLICATION_ABBREVIATION=monitor
ENV APPLICATION_PORT=2000

RUN mkdir -p /application/${APPLICATION_NAME}

WORKDIR /application/${APPLICATION_NAME}

COPY ./maozi-cloud-basics-${APPLICATION_ABBREVIATION}.jar ./

CMD java -server -Xms256m -Xmx256m -Xss256k -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -XX:CompressedClassSpaceSize=32m -XX:ReservedCodeCacheSize=32m -XX:MaxDirectMemorySize=32m --add-opens java.base/java.math=ALL-UNNAMED  --add-opens java.base/java.lang=ALL-UNNAMED  --add-opens java.base/java.lang.reflect=ALL-UNNAMED -jar maozi-cloud-basics-${APPLICATION_ABBREVIATION}.jar

EXPOSE ${APPLICATION_PORT}