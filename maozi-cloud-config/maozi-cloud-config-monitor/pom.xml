<?xml version="1.0" encoding="UTF-8"?>
<!-- 监控配置模块，集成 OpenTelemetry 链路追踪、Spring Boot Admin、Prometheus 指标及 Arthas 在线诊断实现应用可观测性 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承配置聚合父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-config</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- 监控配置模块构件名称 -->
	<artifactId>maozi-cloud-config-monitor</artifactId>


	<dependencies>

		<!-- Spring Boot Begin -->
		<!-- OpenTelemetry Logback MDC 集成，将 traceId/spanId 写入日志 MDC 上下文，实现日志与链路追踪关联 -->
		<dependency>
			<groupId>io.opentelemetry.instrumentation</groupId>
			<artifactId>opentelemetry-logback-mdc-1.0</artifactId>
			<version>${opentelemetry-instrumentation.version}-alpha</version>
		</dependency>

		<!-- Micrometer Tracing OTel 桥接，基于 OpenTelemetry 实现分布式链路追踪数据上报 -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>

<!--		&lt;!&ndash; OpenTelemetry Spring Boot Starter，自动装配链路追踪与指标采集（已改用 agent 方式，暂时注释） &ndash;&gt;-->
<!--		<dependency>-->
<!--			<groupId>io.opentelemetry.instrumentation</groupId>-->
<!--			<artifactId>opentelemetry-spring-boot-starter</artifactId>-->
<!--		</dependency>-->

		<!-- Spring Boot Admin 客户端，将服务注册到 Admin Server 进行统一监控 -->
		<dependency>
			<groupId>de.codecentric</groupId>
			<artifactId>spring-boot-admin-starter-client</artifactId>
			<version>${spring-boot-admin-starter.version}</version>
		</dependency>

		<!-- Micrometer Prometheus 指标导出，支持 Prometheus 采集应用指标 -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Arthas 在线诊断工具，提供运行时类加载、方法监控、热更新等诊断能力 -->
		<dependency>
			<groupId>com.taobao.arthas</groupId>
			<artifactId>arthas-spring-boot-starter</artifactId>
			<version>${arthas.version}</version>
		</dependency>

  </dependencies>


</project>
