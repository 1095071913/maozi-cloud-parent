<?xml version="1.0" encoding="UTF-8"?>
<!-- Web 层配置模块，集成 Undertow 服务器 链路追踪、Nacos 配置中心及缓存等 Web 基础组件 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 继承配置聚合父工程，统一管理依赖版本 -->
	<parent>
		<groupId>com.maozi</groupId>
		<artifactId>maozi-cloud-config</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- Web 层配置模块构件名称 -->
	<artifactId>maozi-cloud-config-web</artifactId>


	<dependencies>

		<!-- Spring Boot Begin -->

		<!-- Spring Boot Web Starter，排除默认 Tomcat 服务器 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
  					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Undertow Web 服务器，替代 Tomcat 作为高性能 Servlet 容器 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-undertow</artifactId>
		</dependency>

		<!-- Nacos 配置中心客户端，从 Nacos 拉取配置 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
		</dependency>
		<!-- Spring Boot End -->


		<!-- Project Begin -->
		<!-- 基础枚举定义，提供通用枚举常量 -->
        <dependency>
            <groupId>com.maozi</groupId>
			<artifactId>maozi-cloud-config-log</artifactId>
			<version>${maozi-cloud-config-log.version}</version>
        </dependency>
        <!-- Project End -->


	</dependencies>


</project>
