<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <contextName>logback</contextName>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <springProperty scope="context" name="ENVIRONMENT" source="project.environment"/>
    <springProperty scope="context" name="APPLICATION_NAME" source="spring.application.name"/>

    <property name="LOG_PATH" value="./logs"/>
    <property name="LOG_PATTERN" value="%clr([ %d{yyyy-MM-dd HH:mm:ss} ]){green}  %clr([ Level：%level ]){blue}  %clr([ TID：%X{trace_id:-} ]){magenta}  %clr([ Service：${APPLICATION_NAME} ]){red}  %clr([ Environment：${ENVIRONMENT} ]){yellow}  %clr([ %m ]){cyan}%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ALL -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 文件路径 ，注意LOG_PATH是默认值,它的配置对应application.properties里的logging.path值-->
        <file>${LOG_PATH}/${APPLICATION_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 文件名称 -->
            <fileNamePattern>${LOG_PATH}/${APPLICATION_NAME}/%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 文件大小切割 -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 文件最大保存历史数量 -->
            <MaxHistory>30</MaxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>


    <appender name ="ASYNC_CONSOLE" class= "ch.qos.logback.classic.AsyncAppender">
        <!-- 队列剩余空间低于 20% 时，会丢弃 TRACE/DEBUG 日志-->
        <discardingThreshold>0</discardingThreshold>
        <!-- 异步日志队列大小-->
        <queueSize>512</queueSize>
        <!-- 是否收集调用者信息-->
        <includeCallerData>false</includeCallerData>
        <!-- 队列满时是否阻塞业务线程-->
        <neverBlock>false</neverBlock>
        <!-- 最终交给 CONSOLE 这个控制台输出器打印-->
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name ="ASYNC_FILE" class= "ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>


    <logger name="root" >
        <if condition='property("ENVIRONMENT").contains("local")'>
            <then><appender-ref ref="ASYNC_CONSOLE"/></then>
            <else><appender-ref ref="ASYNC_FILE"/></else>
        </if>
    </logger>

</configuration>






